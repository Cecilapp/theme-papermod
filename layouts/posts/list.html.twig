{# all the section's posts (the archive ignores pagination) #}
{% set pages = page.pages|default(site.pages.showable|filter_by('section', page.section))|sort_by_date %}

{% extends ['page.html.twig', '_default/page.html.twig'] %}

{% from 'macros/posts.twig' import meta %}

{%- block content ~%}
<section class="mb-20 prose">
  <h1 class="flex gap-x-2">
    <span>{{ page.title|default('Archives'|trans) }}</span>
    <a href="{{ url(page, {format: 'atom'}) }}" class="no-overlay" title="{{ 'Atom feed'|trans }}">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12.75 19.5v-.75a7.5 7.5 0 0 0-7.5-7.5H4.5m0-6.75h.75c7.87 0 14.25 6.38 14.25 14.25v.75M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
      </svg>
    </a>
  </h1>
  <div class="prose text-lg text-gray-700 mb-4">
    {{ page.content }}
  </div>
</section>
  {%- for year, months in pages|sort_by({months: true, years: true}) ~%}
<section class="flex flex-col {% if loop.last == false %}mb-12 pb-8 border-b border-gray-200{% endif %}">
  <h2 id="{{ year }}" class="flex flex-row items-center gap-x-2">
    <span>{{ year }}</span>
    <a href="#{{ year }}" class="self-start no-overlay">
      <svg class="size-4 hover:fill-teal-500 hover:border-none" fill="currentColor" aria-hidden="true" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
        <path d="M0,0H48V48H0Z" transform="translate(0 0)" style="fill: none"/>
        <g>
          <path d="M16,36h4V32H16a8,8,0,0,1,0-16h4V12H16a12,12,0,0,0,0,24Z" transform="translate(0 0)"/>
          <path d="M32,12H28v4h4a8,8,0,0,1,0,16H28v4h4a12,12,0,0,0,0-24Z" transform="translate(0 0)"/>
          <rect x="16" y="22" width="16" height="4"/>
        </g>
      </svg>
    </a>
  </h2>
  {%- for month, posts in months ~%}
  <article class="grid gap-y-4 items-center mt-10 sm:ml-10 md:grid-cols-[20%_80%] md:gap-y-0 md:ml-0">
    <h3 id="{{ year ~ '-' ~ month }}" class="mb-0 self-baseline flex flex-row items-center gap-x-2">
      <span>{{ (year ~ '-' ~ month ~ '-01')|format_date(pattern: 'LLLL')|capitalize }}</span>
      <a href="#{{ year ~ '-' ~ month }}" class="self-start no-overlay">
        <svg class="size-3 hover:fill-teal-500 hover:border-none" fill="currentColor" aria-hidden="true" viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M0,0H48V48H0Z" transform="translate(0 0)" style="fill: none"/>
          <g>
            <path d="M16,36h4V32H16a8,8,0,0,1,0-16h4V12H16a12,12,0,0,0,0,24Z" transform="translate(0 0)"/>
            <path d="M32,12H28v4h4a8,8,0,0,1,0,16H28v4h4a12,12,0,0,0,0-24Z" transform="translate(0 0)"/>
            <rect x="16" y="22" width="16" height="4"/>
          </g>
        </svg>
      </a>
    </h3>
    <ul class="flex flex-col gap-y-4 sm:ml-10 md:ml-0 {% if loop.last == false %}pb-4 border-b border-gray-200{% endif %}">
      {%- for post in posts ~%}
      <li class="flex flex-col gap-y-2 {% if loop.first == false %}mt-4 border-t border-gray-200 sm:mt-0 sm:border-none{% endif %}">
        <h4 class="mb-0 font-medium">
          <a href="{{ url(post) }}" class="no-overlay">{{ post.title }}</a>
        </h4>
        <div class="flex flex-wrap gap-x-2 gap-y-1 items-center text-sm text-gray-600">
          {{ meta(post) }}
        </div>
      </li>
      {%- endfor ~%}
    </ul>
  </article>
    {%- endfor ~%}
</section>
  {%- endfor ~%}
{% endblock %}