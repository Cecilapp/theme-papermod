{% set pages = site.pages.showable %}
{% if page.pages is defined %}
{% set pages = page.pages %}
{% endif %}
{% if page.paginator.pages is defined %}
{% set pages = page.paginator.pages %}
{% endif %}
{% extends ['page.html.twig', '_default/page.html.twig'] %}

{% from 'macros/posts.twig' import card as post_card %}

{% block content %}
<section class="prose mb-12">
  <h1>{{ page.title }}</h1>
  {%- if page.content ~%}
  <div class="text-lg text-gray-700">{{ page.content }}</div>
  {%- endif ~%}
</section>
<div class="flex flex-col space-y-4">
  {%- for post in pages ~%}
  <a href="{{ url(post) }}" class="no-overlay">{{ post_card(post) }}</a>
  {%- endfor ~%}
</div>
{{- include('partials/paginator.html.twig', {page}, with_context = false) ~}}
{% endblock %}