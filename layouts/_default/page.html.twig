<!DOCTYPE html>
<html lang="{{ site.language }}" class="antialiased">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="color-scheme" content="light dark">
    {{- include('partials/metatags.html.twig') ~}}
    {%- block head_css ~%}
    {{- asset('styles/main.css')|html ~}}
    {#- syntax highlighting theme, only for pages with highlighted code ~#}
    {%- if 'hljs-' in page.content|default('') ~%}
    {{- asset('styles/a11y-dark.min.css')|html ~}}
    {%- endif ~%}
    {%- endblock head_css ~%}
    {{- include('partials/pwa.html.twig', {site}, with_context = false, ignore_missing = true) ~}}
  </head>
  <body class="relative flex flex-col min-h-screen bg-white dark:bg-zinc-900 text-gray-800 dark:text-zinc-200 p-4">
    {%- block header ~%}
    <header class="container max-w-7xl mx-auto py-4 flex justify-between items-center">
      <nav class="flex items-center space-x-4">
        <a aria-label="{{ 'Home'|trans }}" class="text-2xl font-bold flex items-center gap-x-2 pointer-events-auto" href="{{ url(site.home) }}">
          {%- if site.papermod.avatar|default(false) ~%}
          <span class="h-10 w-10 rounded-full bg-white/90 dark:bg-zinc-800/90 p-0.5 shadow-lg shadow-gray-800/5 ring-1 ring-gray-900/5 dark:ring-white/10 backdrop-blur-sm">
            {{ asset(site.papermod.avatar)|html(attributes={alt: 'Avatar'|trans, class: 'rounded-full bg-gray-100 dark:bg-zinc-800 object-cover h-9 w-9 text-transparent'}, options={responsive: true, formats: ['webp']}) }}
          </span>
          {%- endif ~%}
          <span class="transition hover:text-teal-500">{{ site.title }}</span>
        </a>
      </nav>
      <nav class="hidden sm:block space-x-4 text-gray-600 dark:text-zinc-400">
        {%- for entry in site.menus.main|default([])|sort_by_weight ~%}
        <a href="{{ url(entry.url) }}" class="transition hover:text-teal-500{% if url(entry.url) == url(page) %} text-teal-500{% endif %}">{{ entry.name }}</a>
        {%- endfor ~%}
      </nav>
    </header>
    {%- endblock header ~%}
    <main class="grow container max-w-5xl mx-auto">
      {%- block content ~%}
      <article class="prose">
        <h1>{{ page.title }}</h1>
        {{ page.content }}
      </article>
      {%- endblock content ~%}
    </main>
    {%- block footer ~%}
    <footer class="container max-w-7xl mx-auto mt-16 py-4 border-t border-gray-200 dark:border-zinc-700 text-gray-600 dark:text-zinc-400">
      <div class="flex flex-wrap-reverse justify-between items-center gap-4 sm:grid sm:grid-cols-2">
        <p class="flex flex-wrap items-center justify-start gap-x-8">
          {%- for entry in site.menus.main|default([])|sort_by_weight ~%}
          <a href="{{ url(entry.url) }}" class="transition hover:text-teal-500">{{ entry.name }}</a>
          {%- endfor ~%}
        </p>
        <p class="flex items-center justify-end space-x-2">
          {%- set licence = site.papermod.licence|default('by-nc-sa') ~%}
          {%- set author = site.author.name|default(site.author|default(site.title)) ~%}
          {%- if licence ~%}
          <a href="https://creativecommons.org/licenses/{{ licence }}/4.0/" title="Creative Commons {{ licence|upper }}" class="flex items-center gap-x-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 inline-block" viewBox="0 0 30 30" aria-hidden="true">
              <path d="M14.972 0c4.196 0 7.769 1.465 10.715 4.393A14.426 14.426 0 0 1 28.9 9.228C29.633 11.04 30 12.964 30 15c0 2.054-.363 3.978-1.085 5.772a13.77 13.77 0 0 1-3.2 4.754 15.417 15.417 0 0 1-4.983 3.322A14.932 14.932 0 0 1 14.973 30c-1.982 0-3.88-.38-5.692-1.14a15.087 15.087 0 0 1-4.875-3.293c-1.437-1.437-2.531-3.058-3.281-4.862A14.71 14.71 0 0 1 0 15c0-1.982.38-3.888 1.138-5.719a15.062 15.062 0 0 1 3.308-4.915C7.303 1.456 10.812 0 14.972 0zm.055 2.706c-3.429 0-6.313 1.196-8.652 3.589a12.896 12.896 0 0 0-2.72 4.031 11.814 11.814 0 0 0-.95 4.675c0 1.607.316 3.156.95 4.646a12.428 12.428 0 0 0 2.72 3.992 12.362 12.362 0 0 0 3.99 2.679c1.483.616 3.037.924 4.662.924 1.607 0 3.164-.312 4.675-.937a12.954 12.954 0 0 0 4.084-2.705c2.339-2.286 3.508-5.152 3.508-8.6 0-1.66-.304-3.231-.91-4.713a11.994 11.994 0 0 0-2.651-3.965c-2.412-2.41-5.314-3.616-8.706-3.616zm-.188 9.803-2.01 1.045c-.215-.445-.477-.758-.79-.937-.312-.178-.602-.268-.87-.268-1.34 0-2.01.884-2.01 2.652 0 .803.17 1.446.509 1.928.34.482.84.724 1.5.724.876 0 1.492-.43 1.85-1.286l1.847.937a4.407 4.407 0 0 1-1.634 1.728c-.696.42-1.464.63-2.303.63-1.34 0-2.42-.41-3.242-1.233-.821-.82-1.232-1.964-1.232-3.428 0-1.428.416-2.562 1.246-3.401.83-.84 1.879-1.26 3.147-1.26 1.858 0 3.188.723 3.992 2.17zm8.652 0-1.983 1.045c-.214-.445-.478-.758-.79-.937-.313-.178-.613-.268-.897-.268-1.34 0-2.01.884-2.01 2.652 0 .803.17 1.446.51 1.928.338.482.838.724 1.5.724.874 0 1.49-.43 1.847-1.286l1.875.937a4.606 4.606 0 0 1-1.66 1.728c-.696.42-1.455.63-2.277.63-1.357 0-2.441-.41-3.253-1.233-.814-.82-1.22-1.964-1.22-3.428 0-1.428.415-2.562 1.246-3.401.83-.84 1.879-1.26 3.147-1.26 1.857 0 3.18.723 3.965 2.17z" fill="currentColor"></path>
            </svg>
            <span>{{ 'now'|date('Y') }} {{ author }}</span>
          </a>
          {%- else ~%}
          <span>© {{ 'now'|date('Y') }} {{ author }}</span>
          {%- endif ~%}
        </p>
      </div>
    </footer>
    {%- endblock footer ~%}
    {%- if site.papermod.overlay|default(true) ~%}
    <div class="overlay" aria-hidden="true"></div>
    {%- endif ~%}
    {%- block scripts %}{% endblock scripts ~%}
    {{- include('partials/analytics.html.twig') ~}}
  </body>
</html>