{% extends ['page.html.twig', '_default/page.html.twig'] %}

{% block content %}
<section class="prose max-w-none grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:gap-y-12">
  <div class="lg:row-span-2">
    <h2>{{ page.page_title|default(page.title) }}</h2>
    <div class="mt-6 text-lg">{{ page.content }}</div>
  </div>
  <div class="not-prose lg:pl-20 lg:mt-32">
    {%- set image = asset(page.image|default(site.papermod.about.image|default('images/about.jpg')), {ignore_missing: true}) ~%}
    {%- if not image.missing ~%}
    {{ image|html({alt: 'Profile picture'|trans, class: 'px-2.5 aspect-square rotate-3 rounded-2xl bg-gray-100 dark:bg-zinc-800 object-cover'}) }}
    {%- endif ~%}
    {%- if site.data.links|default([])|length > 0 ~%}
    <ul role="list" class="mt-16 list-none">
      {%- for element in site.data.links ~%}
      <li class="mt-4">
        <a class="relative z-20 group flex items-center justify-start font-medium text-gray-800 dark:text-zinc-200 transition hover:text-teal-500" href="{{ url(element.href) }}">
          <span aria-hidden="true" class="h-6 w-6 flex-none text-gray-500 dark:text-zinc-400 transition group-hover:text-teal-500 dark:invert [&>svg]:h-6 [&>svg]:w-6">{{ asset(element.picto)|inline }}</span>
          <span class="ml-4">{{ element.title|trans }}</span>
        </a>
      </li>
      {%- endfor ~%}
    </ul>
    {%- endif ~%}
  </div>
</section>
{% endblock %}